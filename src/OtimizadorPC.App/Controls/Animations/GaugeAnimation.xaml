<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.GaugeAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Otimização: velocímetro subindo até o máximo -->
    <local:AnimatedIcon.Resources>
        <Storyboard x:Key="Loop" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Needle" Storyboard.TargetProperty="Angle">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-90" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="68">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="68" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="-90">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="StrokeDashOffset">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="14.2" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1.6">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="1.6" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="14.2">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <Path Data="M24,62 A36,36 0 0 1 96,62" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Path x:Name="Fill" Data="M24,62 A36,36 0 0 1 96,62" StrokeThickness="8" StrokeDashArray="14.2 14.2" StrokeDashOffset="8"
              Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
        <Line X1="60" Y1="62" X2="60" Y2="34" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="{DynamicResource TextFillColorPrimaryBrush}">
            <Line.RenderTransform><RotateTransform x:Name="Needle" CenterX="60" CenterY="62" Angle="-20" /></Line.RenderTransform>
        </Line>
        <Ellipse Canvas.Left="54" Canvas.Top="56" Width="12" Height="12" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Canvas.Left="14" Canvas.Top="58" Text="0" FontSize="9" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock Canvas.Left="98" Canvas.Top="58" Text="max" FontSize="9" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Canvas>
</local:AnimatedIcon>
