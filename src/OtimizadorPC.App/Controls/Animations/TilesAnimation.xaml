<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.TilesAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Dinosize: blocos do mapa de disco surgindo um a um -->
    <local:AnimatedIcon.Resources>
        <BackEase x:Key="Pop" EasingMode="EaseOut" Amplitude="0.5" />
        <Storyboard x:Key="Loop" RepeatBehavior="Forever" Duration="0:0:3.4">
            <DoubleAnimation Storyboard.TargetName="T1" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.00" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T1" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.00" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T2" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.18" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T2" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.18" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T3" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.36" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T3" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.36" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T4" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.54" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T4" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.54" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T5" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.72" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T5" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.72" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T6" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.90" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimation Storyboard.TargetName="T6" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.90" EasingFunction="{StaticResource Pop}" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Map" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.9" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.3" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas x:Name="Map">
        <Rectangle Canvas.Left="14" Canvas.Top="6" Width="46" Height="60" RadiusX="4" RadiusY="4" Fill="#14B8A6" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="T1" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Canvas.Left="63" Canvas.Top="6" Width="43" Height="28" RadiusX="4" RadiusY="4" Fill="#6366F1" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="T2" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Canvas.Left="63" Canvas.Top="37" Width="20" Height="29" RadiusX="4" RadiusY="4" Fill="#F59E0B" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="T3" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Canvas.Left="86" Canvas.Top="37" Width="20" Height="13" RadiusX="3" RadiusY="3" Fill="#EC4899" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="T4" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Canvas.Left="86" Canvas.Top="53" Width="9" Height="13" RadiusX="2" RadiusY="2" Fill="#22C55E" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="T5" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Canvas.Left="97" Canvas.Top="53" Width="9" Height="13" RadiusX="2" RadiusY="2" Fill="#0EA5E9" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="T6" /></Rectangle.RenderTransform>
        </Rectangle>
    </Canvas>
</local:AnimatedIcon>
