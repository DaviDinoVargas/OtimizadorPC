<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.PaperPlaneAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Overclock: aviãozinho de papel voando sobre uma linha tracejada -->
    <local:AnimatedIcon.Resources>
        <PathGeometry x:Key="FlightPath" Figures="M6,62 C30,4 56,74 82,30 S106,8 116,12" />
        <Storyboard x:Key="Loop">
            <MatrixAnimationUsingPath Storyboard.TargetName="PlaneMatrix" Storyboard.TargetProperty="Matrix"
                                      PathGeometry="{StaticResource FlightPath}" DoesRotateWithTangent="True"
                                      Duration="0:0:2.8" RepeatBehavior="Forever"
                                      AccelerationRatio="0.3" DecelerationRatio="0.3" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Plane" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.45" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Trail" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-12" Duration="0:0:0.8" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Cloud1" Storyboard.TargetProperty="X" From="0" To="-30" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Cloud2" Storyboard.TargetProperty="X" From="0" To="24" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas ClipToBounds="False">
        <!-- Nuvens -->
        <Path Data="M78,58 a5,5 0 0 1 9,-3 a6,6 0 0 1 11,2 a4,4 0 0 1 0,8 h-18 a4,4 0 0 1 -2,-7 z" Opacity="0.35" Fill="{DynamicResource TextFillColorTertiaryBrush}">
            <Path.RenderTransform><TranslateTransform x:Name="Cloud1" /></Path.RenderTransform>
        </Path>
        <Path Data="M18,10 a4,4 0 0 1 7,-2 a5,5 0 0 1 9,2 a3,3 0 0 1 0,6 h-14 a3,3 0 0 1 -2,-6 z" Opacity="0.25" Fill="{DynamicResource TextFillColorTertiaryBrush}">
            <Path.RenderTransform><TranslateTransform x:Name="Cloud2" /></Path.RenderTransform>
        </Path>

        <!-- Rota tracejada -->
        <Path x:Name="Trail" Data="{StaticResource FlightPath}" StrokeThickness="1.6" StrokeDashArray="3 3" StrokeDashCap="Round"
              Stroke="{DynamicResource TextFillColorTertiaryBrush}" />

        <!-- Avião (centrado na origem para seguir a rota) -->
        <Canvas x:Name="Plane">
            <Canvas.RenderTransform><MatrixTransform x:Name="PlaneMatrix" Matrix="0.5,-0.85,0.85,0.5,30,24" /></Canvas.RenderTransform>
            <Path Data="M-10,-8 L11,0 L-10,8 L-5,0 Z" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <Path Data="M-10,-8 L-5,0 L11,0 Z" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.35" />
            <Path Data="M-5,0 L11,0" Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="0.8" Opacity="0.7" />
        </Canvas>
    </Canvas>
</local:AnimatedIcon>
