<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.BroomAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Limpeza: vassoura varrendo e brilhos de "limpo" -->
    <local:AnimatedIcon.Resources>
        <Storyboard x:Key="Loop">
            <DoubleAnimation Storyboard.TargetName="Swing" Storyboard.TargetProperty="Angle" From="-22" To="22" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="D1" Storyboard.TargetProperty="X" From="0" To="-26" Duration="0:0:0.7" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Dust1" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.7" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="X" From="0" To="28" Duration="0:0:0.7" BeginTime="0:0:0.7" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Dust2" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.7" BeginTime="0:0:0.7" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="D3" Storyboard.TargetProperty="Y" From="0" To="-10" Duration="0:0:0.9" BeginTime="0:0:0.3" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Dust3" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:0.9" BeginTime="0:0:0.3" RepeatBehavior="Forever" />

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sp1" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever" Duration="0:0:1.6">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sp1" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever" Duration="0:0:1.6">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sp2" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever" Duration="0:0:1.6" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sp2" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever" Duration="0:0:1.6" BeginTime="0:0:0.8">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <!-- Chão -->
        <Line X1="20" Y1="67" X2="100" Y2="67" StrokeThickness="2" StrokeDashArray="1 3" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- Poeira -->
        <Ellipse x:Name="Dust1" Canvas.Left="48" Canvas.Top="60" Width="5" Height="5" Fill="{DynamicResource TextFillColorTertiaryBrush}">
            <Ellipse.RenderTransform><TranslateTransform x:Name="D1" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dust2" Canvas.Left="68" Canvas.Top="61" Width="4" Height="4" Fill="{DynamicResource TextFillColorTertiaryBrush}">
            <Ellipse.RenderTransform><TranslateTransform x:Name="D2" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dust3" Canvas.Left="58" Canvas.Top="58" Width="3" Height="3" Fill="{DynamicResource TextFillColorTertiaryBrush}">
            <Ellipse.RenderTransform><TranslateTransform x:Name="D3" /></Ellipse.RenderTransform>
        </Ellipse>

        <!-- Vassoura (gira em torno do topo do cabo) -->
        <Canvas>
            <Canvas.RenderTransform><RotateTransform x:Name="Swing" CenterX="60" CenterY="4" /></Canvas.RenderTransform>
            <Line X1="60" Y1="4" X2="60" Y2="44" StrokeThickness="4" StrokeStartLineCap="Round" Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
            <Path Data="M51,43 L69,43 L76,64 L44,64 Z" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <Path Data="M50,52 L70,52 M53,58 L67,58" Stroke="{DynamicResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="1.5" />
        </Canvas>

        <!-- Brilhos -->
        <Path Canvas.Left="14" Canvas.Top="14" Data="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6 Z" Fill="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform x:Name="Sp1" ScaleX="0.6" ScaleY="0.6" /></Path.RenderTransform>
        </Path>
        <Path Canvas.Left="90" Canvas.Top="22" Data="M6,0 L7.5,4.5 L12,6 L7.5,7.5 L6,12 L4.5,7.5 L0,6 L4.5,4.5 Z" Fill="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform x:Name="Sp2" ScaleX="0.6" ScaleY="0.6" /></Path.RenderTransform>
        </Path>
    </Canvas>
</local:AnimatedIcon>
