<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.ChipAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Informações: processador com dados correndo pelas trilhas -->
    <local:AnimatedIcon.Resources>
        <Storyboard x:Key="Loop">
            <DoubleAnimation Storyboard.TargetName="Flow" Storyboard.TargetProperty="StrokeDashOffset" From="24" To="0" Duration="0:0:1.2" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Flow2" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="24" Duration="0:0:1.2" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <!-- Trilhas de base -->
        <Path Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5"
              Data="M44,28 H26 V14 H8 M44,44 H24 V58 H8 M76,28 H94 V12 H112 M76,44 H98 V60 H112 M54,20 V4 M66,52 V68" />
        <!-- Dados saindo do chip -->
        <Path x:Name="Flow" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" StrokeDashArray="2 10" StrokeDashCap="Round"
              Data="M44,28 H26 V14 H8 M76,44 H98 V60 H112 M54,20 V4" />
        <!-- Dados entrando no chip -->
        <Path x:Name="Flow2" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" StrokeDashArray="2 10" StrokeDashCap="Round"
              Data="M44,44 H24 V58 H8 M76,28 H94 V12 H112 M66,52 V68" />

        <Ellipse Canvas.Left="6" Canvas.Top="12" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
        <Ellipse Canvas.Left="6" Canvas.Top="56" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
        <Ellipse Canvas.Left="110" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
        <Ellipse Canvas.Left="110" Canvas.Top="58" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />

        <!-- Chip -->
        <Rectangle Canvas.Left="44" Canvas.Top="20" Width="32" Height="32" RadiusX="6" RadiusY="6" StrokeThickness="2"
                   Stroke="{DynamicResource AccentFillColorDefaultBrush}" Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Rectangle x:Name="Core" Canvas.Left="52" Canvas.Top="28" Width="16" Height="16" RadiusX="3" RadiusY="3"
                   Fill="{DynamicResource AccentFillColorDefaultBrush}" />
    </Canvas>
</local:AnimatedIcon>
