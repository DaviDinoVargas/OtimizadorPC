<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.SuccessAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="72" Height="72">
    <!-- Concluído: círculo se desenha, o "check" aparece e brilhos saltam (toca uma vez) -->
    <local:AnimatedIcon.Resources>
        <Storyboard x:Key="Loop">
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="StrokeDashOffset" From="34" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="StrokeDashOffset" From="12" To="0" BeginTime="0:0:0.4" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Sparks" Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:0.6" Duration="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="SparksScale" Storyboard.TargetProperty="ScaleX" From="0.4" To="1.25" BeginTime="0:0:0.5" Duration="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="SparksScale" Storyboard.TargetProperty="ScaleY" From="0.4" To="1.25" BeginTime="0:0:0.5" Duration="0:0:0.6" />
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="Pop" /></Grid.RenderTransform>
        <Canvas x:Name="Sparks" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><ScaleTransform x:Name="SparksScale" /></Canvas.RenderTransform>
            <Ellipse Canvas.Left="34" Canvas.Top="0" Width="5" Height="5" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
            <Ellipse Canvas.Left="66" Canvas.Top="34" Width="5" Height="5" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
            <Ellipse Canvas.Left="34" Canvas.Top="67" Width="5" Height="5" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
            <Ellipse Canvas.Left="1" Canvas.Top="34" Width="5" Height="5" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <Ellipse Canvas.Left="58" Canvas.Top="58" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <Ellipse Canvas.Left="58" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <Ellipse Canvas.Left="10" Canvas.Top="58" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
        </Canvas>
        <!-- Comprimento do círculo (r=24, espessura 5): 2πr/5 ≈ 30,2; usamos 34 para cobrir -->
        <Ellipse x:Name="Ring" Width="52" Height="52" StrokeThickness="5" StrokeDashArray="34 34" StrokeDashOffset="0"
                 Stroke="{DynamicResource SystemFillColorSuccessBrush}" />
        <Path x:Name="Check" Data="M26,37 L33,44 L47,29" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              StrokeDashArray="12 12" Stroke="{DynamicResource SystemFillColorSuccessBrush}" />
    </Grid>
</local:AnimatedIcon>
