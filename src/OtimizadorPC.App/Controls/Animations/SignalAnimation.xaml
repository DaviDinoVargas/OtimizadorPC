<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.SignalAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Rede: ondas de Wi-Fi acendem em sequência e um pacote vai e volta entre o PC e o globo -->
    <local:AnimatedIcon.Resources>
        <SineEase x:Key="Ease" EasingMode="EaseInOut" />
        <Storyboard x:Key="Loop" RepeatBehavior="Forever" Duration="0:0:2.4">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="W1" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" /><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="W2" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" /><LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.25" /><LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="W3" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" /><LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0.25" /><LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
            <!-- pacote: ida e volta -->
            <DoubleAnimation Storyboard.TargetName="PacketMove" Storyboard.TargetProperty="X" From="0" To="58" BeginTime="0:0:0" Duration="0:0:0.9" EasingFunction="{StaticResource Ease}" />
            <DoubleAnimation Storyboard.TargetName="PacketMove" Storyboard.TargetProperty="X" From="58" To="0" BeginTime="0:0:1.2" Duration="0:0:0.9" EasingFunction="{StaticResource Ease}" />
            <!-- globo pisca ao receber -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlobeGlow" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0.8" /><LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <!-- linha tracejada -->
        <Line X1="30" Y1="50" X2="92" Y2="50" Stroke="#334155" StrokeThickness="2" StrokeDashArray="2,2" />

        <!-- PC -->
        <Rectangle Canvas.Left="8" Canvas.Top="38" Width="24" Height="17" RadiusX="2" RadiusY="2" Fill="#1E293B" Stroke="#14B8A6" StrokeThickness="2" />
        <Rectangle Canvas.Left="16" Canvas.Top="56" Width="8" Height="4" Fill="#14B8A6" />
        <Rectangle Canvas.Left="12" Canvas.Top="60" Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="#14B8A6" />

        <!-- ondas de Wi-Fi sobre o PC -->
        <Path x:Name="W1" Data="M14,30 A8,8 0 0 1 26,30" Stroke="#5EEAD4" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.25" />
        <Path x:Name="W2" Data="M10,25 A14,14 0 0 1 30,25" Stroke="#2DD4BF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.25" />
        <Path x:Name="W3" Data="M6,20 A20,20 0 0 1 34,20" Stroke="#14B8A6" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.25" />

        <!-- globo -->
        <Ellipse x:Name="GlobeGlow" Canvas.Left="82" Canvas.Top="30" Width="40" Height="40" Fill="#8B5CF6" Opacity="0">
            <Ellipse.Effect><BlurEffect Radius="10" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Canvas.Left="88" Canvas.Top="36" Width="28" Height="28" Fill="#1E1B4B" Stroke="#8B5CF6" StrokeThickness="2" />
        <Ellipse Canvas.Left="96" Canvas.Top="36" Width="12" Height="28" Stroke="#A78BFA" StrokeThickness="1.5" />
        <Line X1="88" Y1="50" X2="116" Y2="50" Stroke="#A78BFA" StrokeThickness="1.5" />

        <!-- pacote -->
        <Ellipse Canvas.Left="30" Canvas.Top="46" Width="8" Height="8" Fill="#FDE68A">
            <Ellipse.RenderTransform><TranslateTransform x:Name="PacketMove" /></Ellipse.RenderTransform>
            <Ellipse.Effect><DropShadowEffect Color="#FDE68A" BlurRadius="8" ShadowDepth="0" /></Ellipse.Effect>
        </Ellipse>
    </Canvas>
</local:AnimatedIcon>
