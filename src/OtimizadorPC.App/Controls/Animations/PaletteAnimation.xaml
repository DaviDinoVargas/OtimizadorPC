<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.PaletteAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Personalização: cores girando em volta da cor de destaque -->
    <local:AnimatedIcon.Resources>
        <Storyboard x:Key="Loop">
            <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P1" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P1" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P2" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.6" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P2" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.6" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P3" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.6" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P3" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.6" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P4" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.6" BeginTime="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="P4" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.6" BeginTime="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <Ellipse Canvas.Left="34" Canvas.Top="10" Width="52" Height="52" StrokeThickness="1.5" StrokeDashArray="2 3"
                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Canvas>
            <Canvas.RenderTransform><RotateTransform x:Name="Spin" CenterX="60" CenterY="36" /></Canvas.RenderTransform>
            <Ellipse Canvas.Left="51" Canvas.Top="1" Width="18" Height="18" Fill="#EC4899" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="P1" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="77" Canvas.Top="27" Width="18" Height="18" Fill="#F59E0B" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="P2" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="51" Canvas.Top="53" Width="18" Height="18" Fill="#22C55E" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="P3" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="25" Canvas.Top="27" Width="18" Height="18" Fill="#6366F1" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="P4" /></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Ellipse Canvas.Left="50" Canvas.Top="26" Width="20" Height="20" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
    </Canvas>
</local:AnimatedIcon>
