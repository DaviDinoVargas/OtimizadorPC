<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.PackagesAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Programas: a caixa do meio sobe, gira e some; as vizinhas se acomodam e uma nova caixa cai no lugar -->
    <local:AnimatedIcon.Resources>
        <CubicEase x:Key="Out" EasingMode="EaseOut" />
        <BounceEase x:Key="Bounce" EasingMode="EaseOut" Bounces="2" Bounciness="3" />
        <Storyboard x:Key="Loop" RepeatBehavior="Forever" Duration="0:0:3.6">
            <!-- sai -->
            <DoubleAnimation Storyboard.TargetName="MidMove" Storyboard.TargetProperty="Y" From="0" To="-34" BeginTime="0:0:0.5" Duration="0:0:0.7" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="MidSpin" Storyboard.TargetProperty="Angle" From="0" To="-18" BeginTime="0:0:0.5" Duration="0:0:0.7" EasingFunction="{StaticResource Out}" />
            <DoubleAnimation Storyboard.TargetName="Mid" Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:0.8" Duration="0:0:0.4" />
            <!-- tampa abre um pouco antes de sair -->
            <DoubleAnimation Storyboard.TargetName="LidSpin" Storyboard.TargetProperty="Angle" From="0" To="-35" BeginTime="0:0:0.2" Duration="0:0:0.3" AutoReverse="True" />
            <!-- brilho de "removido" -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleX" From="0.4" To="1.4" BeginTime="0:0:0.9" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleY" From="0.4" To="1.4" BeginTime="0:0:0.9" Duration="0:0:0.7" />
            <!-- nova caixa cai -->
            <DoubleAnimation Storyboard.TargetName="MidMove" Storyboard.TargetProperty="Y" From="-60" To="0" BeginTime="0:0:2.2" Duration="0:0:0.8" EasingFunction="{StaticResource Bounce}" />
            <DoubleAnimation Storyboard.TargetName="MidSpin" Storyboard.TargetProperty="Angle" To="0" BeginTime="0:0:2.2" Duration="0:0:0.01" />
            <DoubleAnimation Storyboard.TargetName="Mid" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:2.2" Duration="0:0:0.15" />
            <!-- vizinhas balançam -->
            <DoubleAnimation Storyboard.TargetName="LeftMove" Storyboard.TargetProperty="Y" From="0" To="-3" BeginTime="0:0:2.85" Duration="0:0:0.12" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="RightMove" Storyboard.TargetProperty="Y" From="0" To="-3" BeginTime="0:0:2.9" Duration="0:0:0.12" AutoReverse="True" />
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <!-- prateleira -->
        <Rectangle Canvas.Left="8" Canvas.Top="64" Width="104" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#334155" />

        <!-- caixa da esquerda -->
        <Canvas Canvas.Left="14" Canvas.Top="38">
            <Canvas.RenderTransform><TranslateTransform x:Name="LeftMove" /></Canvas.RenderTransform>
            <Rectangle Width="26" Height="26" RadiusX="4" RadiusY="4" Fill="#6366F1" />
            <Rectangle Canvas.Left="10" Width="6" Height="26" Fill="#818CF8" />
        </Canvas>

        <!-- caixa do meio (a que é desinstalada) -->
        <Canvas x:Name="Mid" Canvas.Left="46" Canvas.Top="32">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="MidSpin" CenterX="16" CenterY="16" />
                    <TranslateTransform x:Name="MidMove" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Top="4" Width="32" Height="28" RadiusX="4" RadiusY="4" Fill="#14B8A6" />
            <Rectangle Canvas.Left="13" Canvas.Top="4" Width="6" Height="28" Fill="#5EEAD4" />
            <!-- tampa -->
            <Rectangle Canvas.Left="-2" Width="36" Height="7" RadiusX="3" RadiusY="3" Fill="#0D9488">
                <Rectangle.RenderTransform><RotateTransform x:Name="LidSpin" CenterX="0" CenterY="7" /></Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <!-- caixa da direita -->
        <Canvas Canvas.Left="84" Canvas.Top="42">
            <Canvas.RenderTransform><TranslateTransform x:Name="RightMove" /></Canvas.RenderTransform>
            <Rectangle Width="22" Height="22" RadiusX="4" RadiusY="4" Fill="#A855F7" />
            <Rectangle Canvas.Left="8" Width="6" Height="22" Fill="#C084FC" />
        </Canvas>

        <!-- brilho -->
        <Canvas x:Name="Spark" Canvas.Left="62" Canvas.Top="8" Opacity="0">
            <Canvas.RenderTransform><ScaleTransform x:Name="SparkScale" /></Canvas.RenderTransform>
            <Path Data="M0,-10 L2,-2 L10,0 L2,2 L0,10 L-2,2 L-10,0 L-2,-2 Z" Fill="#FDE68A" />
        </Canvas>
    </Canvas>
</local:AnimatedIcon>
