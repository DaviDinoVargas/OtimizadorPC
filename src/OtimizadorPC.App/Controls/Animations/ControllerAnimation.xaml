<local:AnimatedIcon x:Class="OtimizadorPC.App.Controls.Animations.ControllerAnimation"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OtimizadorPC.App.Controls.Animations"
                    Width="120" Height="72">
    <!-- Modo Jogo: controle balança, analógico mexe e os botões acendem em combo -->
    <local:AnimatedIcon.Resources>
        <SineEase x:Key="Ease" EasingMode="EaseInOut" />
        <Storyboard x:Key="Loop" RepeatBehavior="Forever" Duration="0:0:2.8">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tilt" Storyboard.TargetProperty="Angle">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" EasingFunction="{StaticResource Ease}" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-6" EasingFunction="{StaticResource Ease}" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="5" EasingFunction="{StaticResource Ease}" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0" EasingFunction="{StaticResource Ease}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Stick" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-3" EasingFunction="{StaticResource Ease}" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="3" EasingFunction="{StaticResource Ease}" /><EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0" EasingFunction="{StaticResource Ease}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Stick" Storyboard.TargetProperty="Y">
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="-3" EasingFunction="{StaticResource Ease}" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="0" EasingFunction="{StaticResource Ease}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BA" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.35" /><LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BB" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.35" /><LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BX" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" /><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BY" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.3" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>
            <!-- faísca de "combo" -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Combo" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:2.15" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="ComboMove" Storyboard.TargetProperty="Y" From="0" To="-10" BeginTime="0:0:2.0" Duration="0:0:0.6" />
        </Storyboard>
    </local:AnimatedIcon.Resources>

    <Canvas>
        <Canvas Canvas.Left="20" Canvas.Top="18">
            <Canvas.RenderTransform><RotateTransform x:Name="Tilt" CenterX="40" CenterY="22" /></Canvas.RenderTransform>
            <!-- corpo -->
            <Path Fill="#1E293B" Stroke="#8B5CF6" StrokeThickness="2"
                  Data="M14,4 L66,4 C76,4 80,14 80,26 C80,38 74,46 66,44 L56,36 L24,36 L14,44 C6,46 0,38 0,26 C0,14 4,4 14,4 Z" />
            <!-- direcional -->
            <Rectangle Canvas.Left="12" Canvas.Top="18" Width="14" Height="4" RadiusX="1" RadiusY="1" Fill="#64748B" />
            <Rectangle Canvas.Left="17" Canvas.Top="13" Width="4" Height="14" RadiusX="1" RadiusY="1" Fill="#64748B" />
            <!-- analógico -->
            <Ellipse Canvas.Left="28" Canvas.Top="24" Width="10" Height="10" Fill="#0F172A" Stroke="#14B8A6" StrokeThickness="1.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Stick" /></Ellipse.RenderTransform>
            </Ellipse>
            <!-- botões -->
            <Ellipse x:Name="BY" Canvas.Left="61" Canvas.Top="10" Width="6" Height="6" Fill="#FACC15" Opacity="0.35" />
            <Ellipse x:Name="BX" Canvas.Left="55" Canvas.Top="16" Width="6" Height="6" Fill="#38BDF8" Opacity="0.35" />
            <Ellipse x:Name="BB" Canvas.Left="67" Canvas.Top="16" Width="6" Height="6" Fill="#F87171" Opacity="0.35" />
            <Ellipse x:Name="BA" Canvas.Left="61" Canvas.Top="22" Width="6" Height="6" Fill="#4ADE80" Opacity="0.35" />
        </Canvas>
        <Path x:Name="Combo" Canvas.Left="92" Canvas.Top="12" Opacity="0" Data="M0,-7 L1.6,-1.6 L7,0 L1.6,1.6 L0,7 L-1.6,1.6 L-7,0 L-1.6,-1.6 Z" Fill="#FDE68A">
            <Path.RenderTransform><TranslateTransform x:Name="ComboMove" /></Path.RenderTransform>
        </Path>
    </Canvas>
</local:AnimatedIcon>
