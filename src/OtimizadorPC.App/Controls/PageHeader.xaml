<UserControl x:Class="OtimizadorPC.App.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Margin="0,0,0,16">
    <!-- Faixa de destaque: degradê da cor de destaque, grade sutil e a animação do módulo -->
    <Border CornerRadius="18" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource AccentGlowBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Rectangle Opacity="0.07" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,0 L26,0 M0,0 L0,26">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="White" Thickness="1" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Width="260" Height="260" HorizontalAlignment="Left" Margin="-70,-90,0,-90" IsHitTestVisible="False"
                     Fill="{DynamicResource BackgroundGlowBrush}" />

            <Grid Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0" Content="{Binding Animation, ElementName=Root}" Margin="0,0,22,0" VerticalAlignment="Center">
                    <ContentPresenter.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </ContentPresenter.LayoutTransform>
                </ContentPresenter>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitle}" />
                    <Border Width="56" Height="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,6,0,6" Background="{DynamicResource AccentGradientBrush}" />
                    <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource PageSubtitle}" Margin="0" />
                </StackPanel>

                <ContentPresenter Grid.Column="2" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
