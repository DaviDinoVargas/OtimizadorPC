<UserControl x:Class="OtimizadorPC.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
             xmlns:pr="clr-namespace:OtimizadorPC.Core.Processes;assembly=OtimizadorPC.Core"
             xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
             xmlns:anim="clr-namespace:OtimizadorPC.App.Controls.Animations"
             xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProcessesViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OtimizadorPC;component/Styles/Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumEqualsConverter x:Key="EnumEq" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:LevelToBrushConverter x:Key="LevelBrush" Warning="0.15" Critical="0.3" />
            <conv:CategoryToBrushConverter x:Key="CatBrush" />

            <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource HoverCard}">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Processos" Subtitle="Veja o que está rodando agora e encerre o que não precisa">
            <c:PageHeader.Animation><anim:EqualizerAnimation /></c:PageHeader.Animation>
        </c:PageHeader>

        <!-- Resumo -->
        <UniformGrid Grid.Row="1" Columns="4">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Processos" />
                    <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Inteiro" Value="{Binding ProcessCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Processador" />
                    <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Percentual" Value="{Binding CpuTotal}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Memória em uso" />
                    <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Percentual" Value="{Binding RamPercent}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding RamText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Text="Dispensáveis" />
                        <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Inteiro" Value="{Binding DispensableCount}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding DispensableMemory, Converter={StaticResource Bytes}}" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon Broom24}"
                               ToolTip="Encerrar processos dispensáveis" Command="{Binding KillDispensableCommand}" AutomationProperties.Name="Encerrar desnecessários" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Busca, filtro e ordenação -->
        <Grid Grid.Row="2" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox VerticalAlignment="Top" PlaceholderText="Buscar programa…" Icon="{ui:SymbolIcon Search24}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filtro" Content="Todos" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Todos}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filtro" Content="Abertos" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Aplicativos}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filtro" Content="Segundo plano" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=SegundoPlano}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filtro" Content="Dispensáveis" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Dispensaveis}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Filtro" Content="Sistema" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Sistema}" />
            </WrapPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,6" Text="Ordenar:" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Ordem" Content="Memória" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Memoria}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Ordem" Content="CPU" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Cpu}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Ordem" Content="Nome" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Nome}" />
            </StackPanel>
        </Grid>

        <ui:InfoBar Grid.Row="3" Margin="0,0,12,8" IsOpen="True" IsClosable="False" Title="Pronto" Severity="Informational" Message="{Binding StatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}" />

        <!-- Lista -->
        <ListBox Grid.Row="4" x:Name="List" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                 HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProcessGroupViewModel}">
                    <Border x:Name="Row" Style="{StaticResource RowCard}" Margin="0" Padding="12,8"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Abrir local do arquivo" Command="{Binding OpenLocationCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Prioridade alta" Command="{Binding PriorityHighCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Prioridade normal" Command="{Binding PriorityNormalCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Prioridade baixa" Command="{Binding PriorityLowCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Encerrar" Command="{Binding KillCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="20" Height="20" VerticalAlignment="Center" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                        <Border Style="{StaticResource Tag}" Margin="8,0,0,0" BorderBrush="{Binding Category, Converter={StaticResource CatBrush}}">
                                            <TextBlock FontSize="11" Foreground="{Binding Category, Converter={StaticResource CatBrush}}" Text="{Binding CategoryText}" />
                                        </Border>
                                        <ui:Button Padding="6,0" Appearance="Transparent" Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" ToolTip="Ver processos">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Count, StringFormat={}{0} proc.}" />
                                        </ui:Button>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Reason}" Visibility="{Binding Reason, Converter={StaticResource NullVis}}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ExeName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right" Text="{Binding CpuText}" />
                                    <ProgressBar Style="{StaticResource ThinProgress}" Height="4" Maximum="100" Value="{Binding CpuPercent, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right" Text="{Binding MemoryText}" />
                                    <ProgressBar Style="{StaticResource ThinProgress}" Height="4" Maximum="0.5" Value="{Binding MemoryFraction, Mode=OneWay}"
                                                 Foreground="{Binding MemoryFraction, Converter={StaticResource LevelBrush}}" />
                                </StackPanel>
                                <ui:Button Grid.Column="4" VerticalAlignment="Center" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Encerrar"
                                           IsEnabled="{Binding IsProtected, Converter={StaticResource InvBool}}"
                                           Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </Grid>

                            <!-- Processos do grupo -->
                            <ItemsControl Margin="36,6,0,0" ItemsSource="{Binding Processes}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pr:ProcessSample}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Pid, StringFormat=PID {0}}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Margin="0,0,12,0" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Margin="0,0,12,0" Text="{Binding MemoryBytes, Converter={StaticResource Bytes}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ui:ProgressRing Grid.Row="4" IsIndeterminate="True" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
    </Grid>
</UserControl>
