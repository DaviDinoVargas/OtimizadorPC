<UserControl x:Class="OtimizadorPC.App.Views.DinosizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
             xmlns:da="clr-namespace:OtimizadorPC.Core.DiskAnalysis;assembly=OtimizadorPC.Core"
             xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
             xmlns:anim="clr-namespace:OtimizadorPC.App.Controls.Animations"
             xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DinosizeViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OtimizadorPC;component/Styles/Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumEqualsConverter x:Key="EnumEq" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:LevelToBrushConverter x:Key="LevelBrush" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:EnumToVisibilityConverter x:Key="EnumVis" />
            <conv:BytesConverter x:Key="Bytes" />

            <ContextMenu x:Key="RowMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Abrir / fechar pasta" Command="{Binding ToggleExpandCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Mostrar no Explorador" Command="{Binding ShowInExplorerCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Mover para outro disco…" Command="{Binding MoveCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="Enviar para a Lixeira" Command="{Binding RecycleCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>

            <!-- Cabeçalho de coluna clicável (ordena) -->
            <Style x:Key="ColumnHeader" TargetType="GridViewColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border x:Name="Bd" Padding="8,6" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="8" />
            <RowDefinition Height="210" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- ================= Barra de ferramentas ================= -->
        <Border Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,10" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource AccentGlowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Width="44" Height="44" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DataTreemap24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Dinosize" />
                    <TextBlock Style="{StaticResource Eyebrow}" Text="ANÁLISE DE DISCO" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <ComboBox Width="340" Margin="0,2,8,2" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}"
                              AutomationProperties.Name="Disco" ToolTip="Disco para analisar" />
                    <ComboBox Width="150" Margin="0,2,8,2" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}"
                              AutomationProperties.Name="Modo de análise" ToolTip="{Binding ModeHint}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Automático" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Rapido"><Setter Property="Text" Value="Rápido" /></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Mft"><Setter Property="Text" Value="Ultra (MFT)" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource GlowButton}" Padding="18,8" Margin="0,2,8,2" Command="{Binding ScanSelectedCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource InvBoolVis}}" AutomationProperties.Name="Analisar">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" Foreground="White" Margin="0,0,6,0" /><TextBlock Text="Analisar" /></StackPanel>
                    </Button>
                    <ui:Button Margin="0,2,8,2" Content="Cancelar" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}" />
                    <ui:Button Margin="0,2,8,2" Content="Pasta…" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding PickFolderCommand}"
                               IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}" ToolTip="Analisar uma pasta específica" />
                </WrapPanel>
                <ui:TextBox Grid.Column="3" Width="220" VerticalAlignment="Center" PlaceholderText="Filtrar pastas…" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding HasResult}" />
            </Grid>
        </Border>

        <!-- ================= Status ================= -->
        <StackPanel Grid.Row="1" Margin="2,0,0,8">
            <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <c:CountUpText FontFamily="{StaticResource NumberFont}" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Format="Inteiro" Suffix=" arquivos" Value="{Binding ProgressFiles}" />
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <c:CountUpText FontFamily="{StaticResource NumberFont}" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Format="Bytes" Value="{Binding ProgressBytes}" />
                    <TextBlock Text="{Binding Elapsed, StringFormat=  ·  {0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding ProgressPath}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}" />
            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ResultSummary}" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}" />
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ResultNote}"
                       Visibility="{Binding ResultNote, Converter={StaticResource NullVis}}" />
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding OperationMessage}"
                       Visibility="{Binding OperationMessage, Converter={StaticResource NullVis}}" />
        </StackPanel>

        <!-- ================= Tela inicial: escolha um disco ================= -->
        <Border Grid.Row="2" Grid.RowSpan="3" Style="{StaticResource SectionCard}" Margin="0" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900">
                <anim:TilesAnimation HorizontalAlignment="Center">
                    <anim:TilesAnimation.LayoutTransform><ScaleTransform ScaleX="1.4" ScaleY="1.4" /></anim:TilesAnimation.LayoutTransform>
                </anim:TilesAnimation>
                <TextBlock HorizontalAlignment="Center" Margin="0,12,0,4" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="O que está ocupando seu disco?" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}" Margin="0,0,0,18" Text="Clique em um disco para analisar, ou use &quot;Pasta…&quot; para uma pasta específica." />
                <ItemsControl ItemsSource="{Binding Drives}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriveCard}">
                            <Button Width="200" Margin="6" Cursor="Hand" Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="14" Padding="16,14" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource HoverGlowEffect}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconTile}" Width="32" Height="32"><ui:SymbolIcon Symbol="Storage24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Media}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,12,0,6" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}"
                                                 Foreground="{Binding UsedFraction, Converter={StaticResource LevelBrush}}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ================= Árvore + treemap ================= -->
        <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCard}" Margin="0" Padding="0">
                <ListView x:Name="Tree" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          KeyDown="OnTreeKeyDown" AutomationProperties.Name="Árvore de pastas">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="Margin" Value="4,1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid>
                                            <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                                            <Border x:Name="Sel" CornerRadius="8" Opacity="0" Background="{DynamicResource AccentGradientSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentGlowBrush}" BorderThickness="1" />
                                            <GridViewRowPresenter Margin="0,3" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Sel" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn Width="215">
                                <GridViewColumnHeader Content="Nome" Command="{Binding SortByCommand}" CommandParameter="Nome" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:TreeRow}">
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                            <Button Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                                    Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanExpand, Converter={StaticResource BoolVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                                                </Button.Template>
                                                <ui:SymbolIcon FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="ChevronRight24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Symbol" Value="ChevronDown24" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Button>
                                            <Border Width="18" Visibility="{Binding CanExpand, Converter={StaticResource InvBoolVis}}" />
                                            <Border Width="4" Height="16" CornerRadius="2" Margin="2,0,6,0" Background="{Binding ColorBrush}" />
                                            <ui:SymbolIcon FontSize="15" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Document24" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Symbol" Value="Folder24" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Text="{Binding PathHint}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding PathHint, Converter={StaticResource NullVis}}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumnHeader Content="Tamanho" Command="{Binding SortByCommand}" CommandParameter="Tamanho" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:TreeRow}">
                                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SizeText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100">
                                <GridViewColumnHeader Content="% da pasta" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:TreeRow}">
                                        <Grid Width="86">
                                            <ProgressBar Style="{StaticResource ThinProgress}" Height="14" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding ColorBrush}" Opacity="0.85" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White" Text="{Binding PercentText}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="72">
                                <GridViewColumnHeader Content="Arquivos" Command="{Binding SortByCommand}" CommandParameter="Arquivos" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:TreeRow}">
                                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FilesText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="84">
                                <GridViewColumnHeader Content="Modificado" Command="{Binding SortByCommand}" CommandParameter="Modificado" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:TreeRow}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ModifiedText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0" Padding="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Padding="6" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Subir um nível" Command="{Binding GoUpCommand}" AutomationProperties.Name="Subir um nível" />
                        <ItemsControl Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type da:DirNode}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:HyperlinkButton Padding="3,1" FontSize="12" Content="{Binding Name}"
                                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Margin="4,6,0,0" Style="{StaticResource CaptionText}" Text="{Binding TreemapTitle}" TextTrimming="CharacterEllipsis" />
                    <Border CornerRadius="8" ClipToBounds="True">
                        <c:TreemapView Root="{Binding TreemapRoot}" ActivateCommand="{Binding RevealCommand}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}" />

        <!-- ================= Painel inferior ================= -->
        <Border Grid.Row="4" Style="{StaticResource SectionCard}" Margin="0" Padding="10,8" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <WrapPanel>
                        <RadioButton Style="{StaticResource SegmentButton}" Padding="14,5" GroupName="Baixo" Content="Maiores arquivos" IsChecked="{Binding BottomTab, Converter={StaticResource EnumEq}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Padding="14,5" GroupName="Baixo" Content="Tipos de arquivo" IsChecked="{Binding BottomTab, Converter={StaticResource EnumEq}, ConverterParameter=1}" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ui:Button Margin="0,0,6,0" Padding="10,5" Content="Explorador" Icon="{ui:SymbolIcon Open24}" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding SelectedRow}"
                                   ToolTip="Mostrar a pasta selecionada no Explorador" />
                        <ui:Button Margin="0,0,6,0" Padding="10,5" Content="Mover…" Icon="{ui:SymbolIcon ArrowMove24}" Command="{Binding MoveCommand}" CommandParameter="{Binding SelectedRow}"
                                   ToolTip="Mover a pasta selecionada para outro disco" />
                        <ui:Button Padding="10,5" Appearance="Danger" Content="Lixeira" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RecycleCommand}" CommandParameter="{Binding SelectedRow}"
                                   ToolTip="Enviar a pasta selecionada para a Lixeira (tecla Delete)" />
                        <ui:ProgressRing Width="18" Height="18" Margin="8,0,0,0" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <ListBox ItemsSource="{Binding LargestFiles}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding BottomTab, Converter={StaticResource EnumVis}, ConverterParameter=0}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding File.Name}" />
                                <Setter Property="Padding" Value="6,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileRow}">
                                <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Mostrar no Explorador" Command="{Binding ShowInExplorerCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Enviar para a Lixeira" Command="{Binding RecycleCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="18" Height="18" Source="{Binding Icon}" />
                                    <StackPanel Grid.Column="1" Margin="6,0">
                                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding Kind}" />
                                    <TextBlock Grid.Column="3" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox ItemsSource="{Binding Extensions}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding BottomTab, Converter={StaticResource EnumVis}, ConverterParameter=1}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ExtensionRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Stat.Extension}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding Stat.Kind}" />
                                    <ProgressBar Grid.Column="2" Style="{StaticResource ThinProgress}" VerticalAlignment="Center" Margin="0,0,12,0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding Stat.Count, StringFormat={}{0:N0} arquivos}" />
                                    <TextBlock Grid.Column="4" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
