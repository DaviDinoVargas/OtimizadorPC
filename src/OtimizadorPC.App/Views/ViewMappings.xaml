<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
                    xmlns:views="clr-namespace:OtimizadorPC.App.Views">

    <!-- Liga cada ViewModel de página à sua View -->

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MachineInfoViewModel}">
        <views:MachineInfoView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
        <views:CleanupView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OptimizationViewModel}">
        <views:OptimizationView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <views:ProcessesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DinosizeViewModel}">
        <views:DinosizeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
        <views:ProgramsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OverclockViewModel}">
        <views:OverclockView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
</ResourceDictionary>
