<UserControl x:Class="OtimizadorPC.App.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
             xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
             xmlns:anim="clr-namespace:OtimizadorPC.App.Controls.Animations"
             xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OptimizationViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OtimizadorPC;component/Styles/Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:ServiceModeTextConverter x:Key="ModeText" />
            <conv:SuccessToBrushConverter x:Key="OkBrush" />
            <conv:InverseBoolConverter x:Key="InvBool" />

            <!-- ============ Otimização rápida ============ -->
            <DataTemplate DataType="{x:Type vm:QuickTab}">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Melhorias recomendadas para este computador" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Summary}" />
                                <CheckBox Margin="0,10,0,0" Content="Criar ponto de restauração do Windows antes de aplicar"
                                          IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding IsAdministrator}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:Button Margin="0,0,8,0" Content="Analisar de novo" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
                                <ui:Button Appearance="Primary" Content="Aplicar selecionadas" Icon="{ui:SymbolIcon Flash24}" Command="{Binding ApplyCommand}"
                                           IsEnabled="{Binding HasActions}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsApplying, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuickAction}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanRun}" AutomationProperties.Name="{Binding Title}" />
                                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" MaxWidth="260" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{Binding Succeeded, Converter={StaticResource OkBrush}}" Text="{Binding Result}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- ============ Inicialização ============ -->
            <DataTemplate DataType="{x:Type vm:StartupTab}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="{Binding Summary}" />
                        <ui:Button HorizontalAlignment="Right" Content="Atualizar" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
                    </Grid>
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupEntry}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Item.Name}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Item.SourceText}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Item.Command}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Item.Command}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanChange}"
                                                         AutomationProperties.Name="{Binding Item.Name}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- ============ Serviços ============ -->
            <DataTemplate DataType="{x:Type vm:ServicesTab}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left"
                                   Text="Serviços conhecidos que costumam rodar sem necessidade. &quot;Manual&quot; não desliga o programa: o serviço inicia quando o programa precisar." />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Content="Atualizar" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
                            <ui:Button Appearance="Primary" Content="Aplicar recomendados" Command="{Binding ApplyRecommendedCommand}" IsEnabled="{Binding IsAdministrator}" />
                        </StackPanel>
                    </Grid>
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServiceEntry}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                                                         ToolTip="Em execução" />
                                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Status.DisplayName}" />
                                                <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status.Definition.Category}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Status.Definition.Description}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Text="{Binding RecommendedText}" Visibility="{Binding IsRecommended, Converter={StaticResource InvBoolVis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsChanging, Converter={StaticResource BoolVis}}" />
                                            <ComboBox Width="200" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="{Binding Status.DisplayName}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ModeText}}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- ============ Tarefas agendadas ============ -->
            <DataTemplate DataType="{x:Type vm:TasksTab}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="Tarefas criadas por programas instalados (as do Windows não aparecem aqui)." />
                        <ui:Button HorizontalAlignment="Right" Content="Atualizar" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
                    </Grid>
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskEntry}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Info.Name}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding NextRunText}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Info.Action}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Info.Path}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{Binding Info.Name}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- ============ Ajustes e energia ============ -->
            <DataTemplate DataType="{x:Type vm:TweaksTab}">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Plano de energia" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10" Text="Em desktops, Alto desempenho mantém o processador pronto para responder." />
                            <ItemsControl ItemsSource="{Binding Plans}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PowerPlanEntry}">
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Plano" Content="{Binding Name}" IsChecked="{Binding IsActive, Mode=OneWay}"
                                                     Command="{Binding DataContext.ActivatePlanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Margin="0,4,0,0" Content="Ativar Desempenho Máximo" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding EnableUltimateCommand}" />
                        </StackPanel>
                    </Border>
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TweakEntry}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding State.Info.Name}" />
                                                <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding State.Info.Category}" />
                                                </Border>
                                                <Border Style="{StaticResource Tag}" Visibility="{Binding State.Info.NeedsRestart, Converter={StaticResource BoolVis}}">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="reiniciar" />
                                                </Border>
                                                <Border Style="{StaticResource Tag}" Visibility="{Binding State.Info.RequiresAdmin, Converter={StaticResource BoolVis}}">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="admin" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding State.Info.Description}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanChange}"
                                                         AutomationProperties.Name="{Binding State.Info.Name}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!-- ============ Memória virtual ============ -->
            <DataTemplate DataType="{x:Type vm:PageFileTab}">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Configuração atual" />
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding CurrentText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Nova configuração" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                                       Text="A memória virtual é usada quando a RAM enche. Em um SSD o computador trava muito menos nessas horas. Vale depois de reiniciar." />
                            <CheckBox Content="Deixar o Windows gerenciar automaticamente" IsChecked="{Binding Automatic}" Margin="0,0,0,10" />
                            <StackPanel IsEnabled="{Binding Automatic, Converter={StaticResource InvBool}}">
                                <TextBlock Style="{StaticResource CaptionText}" Text="Unidade" />
                                <ComboBox Width="460" HorizontalAlignment="Left" Margin="0,4,0,10" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Tamanho inicial (MB)" />
                                        <ui:NumberBox Width="180" Margin="0,4,0,0" Minimum="16" Maximum="131072" SmallChange="512" Value="{Binding InitialMb}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Tamanho máximo (MB)" />
                                        <ui:NumberBox Width="180" Margin="0,4,0,0" Minimum="16" Maximum="131072" SmallChange="512" Value="{Binding MaximumMb}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="{Binding Suggestion}" />
                            </StackPanel>
                            <ui:Button Margin="0,14,0,0" Appearance="Primary" Content="Aplicar" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsAdministrator}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ============ Apps pré-instalados ============ -->
            <DataTemplate DataType="{x:Type vm:AppsTab}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Apps que vêm com o Windows e podem ser removidos com segurança. Todos podem ser reinstalados pela Microsoft Store." />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Content="Atualizar" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
                            <ui:Button Appearance="Danger" Content="Remover selecionados" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveSelectedCommand}" />
                        </StackPanel>
                    </Grid>
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="Nenhum app pré-instalado conhecido foi encontrado." Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AppEntry}">
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding App.Definition.DisplayName}" />
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding App.Definition.DisplayName}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding App.Definition.Description}" />
                                        </StackPanel>
                                        <ui:ProgressRing Grid.Column="2" Width="18" Height="18" IsIndeterminate="True" Visibility="{Binding IsRemoving, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Padding="{DynamicResource PagePadding}">
        <StackPanel>
            <c:PageHeader Title="Otimização" Subtitle="Inicialização, serviços, energia, memória virtual e ajustes do Windows">
                <c:PageHeader.Animation><anim:GaugeAnimation /></c:PageHeader.Animation>
            </c:PageHeader>

            <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolVis}}">
                <ui:InfoBar Title="Modo limitado" IsOpen="True" IsClosable="False" Severity="Warning"
                            Message="Serviços, ajustes do sistema e memória virtual exigem administrador. Itens de usuário funcionam normalmente." />
                <ui:Button Margin="0,6,0,0" Content="Reabrir como administrador" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding RestartAsAdminCommand}" />
            </StackPanel>

            <ListBox Style="{StaticResource PillTabList}" ItemContainerStyle="{StaticResource PillTabItem}" ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OptimizationTab}">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock FontSize="13" Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:InfoBar Margin="0,0,0,10" IsOpen="True" IsClosable="False" Title="Aviso" Message="{Binding StatusMessage}" Severity="Error"
                        Visibility="{Binding StatusIsError, Converter={StaticResource BoolVis}}" />
            <ui:InfoBar Margin="0,0,0,10" IsOpen="True" IsClosable="False" Title="Pronto" Message="{Binding StatusMessage}" Severity="Success"
                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}" />

            <c:AnimatedContentControl Content="{Binding SelectedTab}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
