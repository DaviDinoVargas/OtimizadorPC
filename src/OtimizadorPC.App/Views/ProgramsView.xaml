<UserControl x:Class="OtimizadorPC.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
             xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
             xmlns:anim="clr-namespace:OtimizadorPC.App.Controls.Animations"
             xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProgramsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OtimizadorPC;component/Styles/Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumEqualsConverter x:Key="EnumEq" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:BytesConverter x:Key="Bytes" />

            <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource HoverCard}">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="Programas" Subtitle="Desinstale vários de uma vez e limpe o que eles deixam para trás">
            <c:PageHeader.Animation><anim:PackagesAnimation /></c:PageHeader.Animation>
            <c:PageHeader.Actions>
                <ui:Button Content="Atualizar" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBatchRunning, Converter={StaticResource InvBool}}" />
            </c:PageHeader.Actions>
        </c:PageHeader>

        <!-- Resumo -->
        <UniformGrid Grid.Row="1" Columns="4">
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Instalados" />
                        <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Inteiro" Value="{Binding TotalCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Storage24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Espaço ocupado" />
                        <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Bytes" Value="{Binding TotalSize}" />
                        <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Text="medindo pastas…" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="CheckboxChecked24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Selecionados" />
                        <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Inteiro" Value="{Binding CheckedCount}" />
                        <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Text="{Binding CheckedSize, Converter={StaticResource Bytes}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" /></Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Entradas órfãs" />
                        <c:CountUpText Style="{StaticResource BigNumber}" FontSize="26" Format="Inteiro" Value="{Binding BrokenCount}" />
                        <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Text="desinstalador sumiu" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Busca, filtros e ordenação -->
        <Grid Grid.Row="2" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox VerticalAlignment="Top" PlaceholderText="Buscar programa ou editor…" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PFiltro" Content="Todos" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Todos}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PFiltro" Content="Programas" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Programas}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PFiltro" Content="Loja" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Loja}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PFiltro" Content="Mais de 1 GB" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Grandes}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PFiltro" Content="Recentes" ToolTip="Instalados nos últimos 30 dias" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Recentes}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="PFiltro" Content="Órfãos" IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Orfaos}" />
            </WrapPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,6" Text="Ordenar:" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="POrdem" Content="Tamanho" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Tamanho}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="POrdem" Content="Nome" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Nome}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="POrdem" Content="Data" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Data}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="POrdem" Content="Editor" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Editor}" />
            </StackPanel>
        </Grid>

        <ui:InfoBar Grid.Row="3" Margin="0,0,12,8" IsOpen="True" IsClosable="False" Title="Concluído" Severity="Informational" Message="{Binding StatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}" />

        <Grid Grid.Row="4" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />

            <!-- Lista de programas -->
            <ListBox x:Name="List" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista de programas">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProgramRow}">
                        <Border x:Name="Row" Style="{StaticResource RowCard}" Margin="0" Padding="10,8"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Desinstalar" Command="{Binding UninstallOneCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Abrir pasta de instalação" Command="{Binding OpenFolderCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Pesquisar na web" Command="{Binding SearchWebCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Remover só a entrada da lista (órfãos)" Command="{Binding RemoveEntryCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name, StringFormat=Selecionar {0}}"
                                          IsEnabled="{Binding IsWorking, Converter={StaticResource InvBool}}" />
                                <Grid Grid.Column="1" Width="34" Height="34" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource IconTile}" Width="34" Height="34">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding Icon, Converter={StaticResource NullVis}}">
                                        <Image Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="2" Margin="6,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                        <Border Style="{StaticResource Tag}" Margin="8,0,0,0" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding IsStore, Converter={StaticResource BoolVis}}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="Loja" />
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Margin="8,0,0,0" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding IsBroken, Converter={StaticResource BoolVis}}"
                                                ToolTip="O desinstalador deste programa não existe mais. Use o menu (botão direito) para remover a entrada.">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="Órfão" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" Visibility="{Binding Details, Converter={StaticResource NullVis}}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding Status}"
                                               Visibility="{Binding Status, Converter={StaticResource NullVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Text="Instalado em" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding DateText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SizeText}" />
                                    <ProgressBar Style="{StaticResource ThinProgress}" Height="4" Margin="0,4,0,0"
                                                 Maximum="{Binding DataContext.MaxSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{Binding SizeBytes, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ProgressRing Width="20" Height="20" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}" />
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Desinstalar" AutomationProperties.Name="{Binding Name, StringFormat=Desinstalar {0}}"
                                               Command="{Binding DataContext.UninstallOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                               IsEnabled="{Binding DataContext.IsBatchRunning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBool}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentGradientSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sobras encontradas -->
            <Border Grid.Column="1" Width="360" Margin="12,0,0,0" Style="{StaticResource SectionCard}" Padding="14,12"
                    BorderBrush="{DynamicResource AccentGlowBrush}" Visibility="{Binding HasLeftovers, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="SOBRAS ENCONTRADAS" />
                        <TextBlock Margin="0,4,0,2" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding LeftoversSize, Converter={StaticResource Bytes}}" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Pastas e chaves que os programas deixaram. As marcadas são as mais seguras de remover; pastas vão para a Lixeira." />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Margin="0,0,8,0" Content="Ignorar" Command="{Binding DismissLeftoversCommand}" />
                        <Button Style="{StaticResource GlowButton}" Padding="14,7" Command="{Binding RemoveLeftoversCommand}" Content="Remover marcadas" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Leftovers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LeftoverRow}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox MinWidth="0" VerticalAlignment="Top" IsChecked="{Binding IsChecked}" />
                                        <StackPanel Grid.Column="1" Margin="2,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon FontSize="13" Margin="0,0,4,0" Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Key24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Symbol" Value="Folder24" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Leftover.ProgramName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Leftover.Path}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:HyperlinkButton Grid.Column="2" Padding="4,0" FontSize="11" VerticalAlignment="Top" Content="{Binding SizeText}"
                                                            ToolTip="Abrir a pasta (ou copiar o caminho da chave)"
                                                            Command="{Binding DataContext.OpenLeftoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barra de ação (aparece ao marcar programas) -->
        <Border Grid.Row="5" Margin="0,10,12,0" Style="{StaticResource SectionCard}" Padding="16,10" Background="{DynamicResource HeroBrush}"
                BorderBrush="{DynamicResource AccentGlowBrush}" Visibility="{Binding ShowActionBar, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBatchRunning, Converter={StaticResource InvBoolVis}}">
                        <CheckBox Content="Silencioso quando possível" IsChecked="{Binding Quiet}" Margin="0,0,16,0"
                                  ToolTip="Usa o modo silencioso do próprio instalador (MSI e programas que oferecem). Os demais abrem o desinstalador normal." />
                        <CheckBox Content="Criar ponto de restauração antes" IsChecked="{Binding CreateRestorePoint}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding BatchText}" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,6,0,0" Maximum="1" Value="{Binding BatchProgress, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <ui:Button Margin="0,0,8,0" Content="Limpar seleção" Command="{Binding ClearSelectionCommand}" Visibility="{Binding IsBatchRunning, Converter={StaticResource InvBoolVis}}" />
                    <ui:Button Margin="0,0,8,0" Content="Parar depois do atual" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelBatchCommand}" Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolVis}}" />
                    <Button Style="{StaticResource GlowButton}" Padding="18,9" Command="{Binding UninstallCheckedCommand}" AutomationProperties.Name="Desinstalar selecionados"
                            IsEnabled="{Binding IsBatchRunning, Converter={StaticResource InvBool}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CheckedCount, StringFormat=Desinstalar {0} selecionado(s)}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
