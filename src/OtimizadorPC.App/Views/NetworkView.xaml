<UserControl x:Class="OtimizadorPC.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
             xmlns:net="clr-namespace:OtimizadorPC.Core.Network;assembly=OtimizadorPC.Core"
             xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
             xmlns:anim="clr-namespace:OtimizadorPC.App.Controls.Animations"
             xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
             x:Name="Root"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:NetworkViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OtimizadorPC;component/Styles/Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:QualityToBrushConverter x:Key="QualityBrush" />
            <conv:WidthToColumnsConverter x:Key="Cols" WideThreshold="1050" Wide="4" Narrow="2" />
            <conv:WidthToColumnsConverter x:Key="RepairCols" WideThreshold="900" Wide="3" Narrow="1" />

            <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource HoverCard}">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Padding="{DynamicResource PagePadding}">
        <StackPanel>
            <c:PageHeader Title="Rede e DNS" Subtitle="Teste a conexão para jogos, escolha o DNS mais rápido e conserte a internet">
                <c:PageHeader.Animation><anim:SignalAnimation /></c:PageHeader.Animation>
            </c:PageHeader>

            <!-- Adaptador + nota geral -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Width="52" Height="52" VerticalAlignment="Top">
                            <ui:SymbolIcon FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="PlugConnected24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAdapter.Kind}" Value="WiFi"><Setter Property="Symbol" Value="Wifi124" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding AdapterKindText}" />
                                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding SelectedAdapter.Description, FallbackValue=Nenhum adaptador conectado}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" MinWidth="150" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                                          DisplayMemberPath="Name" Visibility="{Binding HasMultipleAdapters, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Adaptador" />
                            </Grid>
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="IP local" />
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding SelectedAdapter.Ipv4, FallbackValue=—}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Roteador" />
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding SelectedAdapter.Gateway, FallbackValue=—}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Velocidade do link" />
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding AdapterSpeedText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="DNS" />
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding AdapterDnsText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource AccentGlowBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="CONEXÃO PARA JOGOS" />
                        <StackPanel Grid.Row="1" Margin="0,6,0,8">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="26" Foreground="{Binding OverallQuality, Converter={StaticResource QualityBrush}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Não testada" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallQuality}" Value="Excelente"><Setter Property="Text" Value="Excelente" /></DataTrigger>
                                            <DataTrigger Binding="{Binding OverallQuality}" Value="Boa"><Setter Property="Text" Value="Boa" /></DataTrigger>
                                            <DataTrigger Binding="{Binding OverallQuality}" Value="Regular"><Setter Property="Text" Value="Regular" /></DataTrigger>
                                            <DataTrigger Binding="{Binding OverallQuality}" Value="Ruim"><Setter Property="Text" Value="Instável" /></DataTrigger>
                                            <DataTrigger Binding="{Binding OverallQuality}" Value="SemResposta"><Setter Property="Text" Value="Sem internet" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="{Binding OverallText}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Style="{StaticResource GlowButton}" Padding="16,8" Command="{Binding RunPingTestCommand}" AutomationProperties.Name="Testar conexão"
                                    Visibility="{Binding IsPinging, Converter={StaticResource InvBoolVis}}">
                                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Pulse24" Foreground="White" Margin="0,0,6,0" /><TextBlock Text="Testar conexão" /></StackPanel>
                            </Button>
                            <ui:Button Content="Parar" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopPingTestCommand}" Visibility="{Binding IsPinging, Converter={StaticResource BoolVis}}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Visibility="{Binding IsPinging, Converter={StaticResource BoolVis}}"
                                       Text="{Binding Round, StringFormat=medição {0} de 20}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Latência por destino -->
            <TextBlock Style="{StaticResource Eyebrow}" Margin="2,4,0,8" Text="LATÊNCIA (PING)" />
            <ItemsControl ItemsSource="{Binding Pings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Cols}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PingRow}">
                        <Border Style="{StaticResource Card}" Padding="14,10,14,0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Target.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Target.Group}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Tag}" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{Binding Quality, Converter={StaticResource QualityBrush}}">
                                        <TextBlock FontSize="11" Foreground="{Binding Quality, Converter={StaticResource QualityBrush}}" Text="{Binding QualityText}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock FontFamily="{StaticResource NumberFont}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding AvgText}" />
                                    <TextBlock Margin="4,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource CaptionText}" Text="ms" />
                                    <TextBlock Margin="8,0,0,6" VerticalAlignment="Bottom" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Method}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                <c:Sparkline Grid.Row="3" Margin="-14,4,-14,0" Maximum="0" Values="{Binding History}" Stroke="{Binding Quality, Converter={StaticResource QualityBrush}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- DNS -->
            <Grid Margin="2,8,12,8">
                <TextBlock Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Text="SERVIDOR DNS" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolVis}}" />
                    <ui:Button Content="Testar DNS" Icon="{ui:SymbolIcon TopSpeed24}" Command="{Binding BenchmarkDnsCommand}" AutomationProperties.Name="Testar DNS"
                               IsEnabled="{Binding IsBenchmarking, Converter={StaticResource InvBool}}" />
                </StackPanel>
            </Grid>
            <TextBlock Margin="2,0,12,8" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="O DNS traduz nomes (google.com) em endereços. Um DNS mais rápido faz sites e lançadores de jogos abrirem mais depressa — não muda o ping dentro da partida." />
            <ui:InfoBar Margin="0,0,12,8" IsOpen="True" IsClosable="False" Title="DNS" Severity="Informational" Message="{Binding DnsMessage}"
                        Visibility="{Binding DnsMessage, Converter={StaticResource NullVis}}" />
            <ItemsControl ItemsSource="{Binding DnsRows}" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DnsRow}">
                        <Border x:Name="Row" Style="{StaticResource RowCard}" Margin="0,0,0,6" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Provider.Name}" />
                                        <Border Style="{StaticResource Tag}" Margin="8,0,0,0" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="em uso" />
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Margin="6,0,0,0" BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding IsBest, Converter={StaticResource BoolVis}}">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="mais rápido" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Servers}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding Provider.Description}" TextWrapping="Wrap" />
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ProgressBar Style="{StaticResource ThinProgress}" Height="6" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,0,70,0" VerticalAlignment="Center" />
                                    <ui:ProgressRing Width="16" Height="16" HorizontalAlignment="Right" IsIndeterminate="True" Visibility="{Binding IsTesting, Converter={StaticResource BoolVis}}" />
                                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding AvgText}" Visibility="{Binding IsTesting, Converter={StaticResource InvBoolVis}}" />
                                </Grid>
                                <ui:Button Grid.Column="3" Content="Usar" MinWidth="70" Command="{Binding DataContext.ApplyDnsCommand, ElementName=Root}" CommandParameter="{Binding}"
                                           IsEnabled="{Binding IsCurrent, Converter={StaticResource InvBool}}" AutomationProperties.Name="{Binding Provider.Name, StringFormat=Usar {0}}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Reparos -->
            <TextBlock Style="{StaticResource Eyebrow}" Margin="2,14,0,8" Text="CONSERTAR A INTERNET" />
            <ui:InfoBar Margin="0,0,12,8" IsOpen="True" IsClosable="False" Title="Reparo" Severity="Informational" Message="{Binding RepairMessage}"
                        Visibility="{Binding RepairMessage, Converter={StaticResource NullVis}}" />
            <UniformGrid Columns="{Binding ActualWidth, ElementName=Root, Converter={StaticResource RepairCols}}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Limpar" Command="{Binding FlushDnsCommand}" AutomationProperties.Name="Limpar cache de DNS" />
                        <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left"><ui:SymbolIcon Symbol="Broom24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                        <StackPanel Margin="12,0,8,0">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Limpar cache de DNS" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Site não abre ou abre a versão antiga. Instantâneo." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Renovar" Command="{Binding QuickRepairCommand}" IsEnabled="{Binding IsRepairing, Converter={StaticResource InvBool}}" />
                        <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left"><ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                        <StackPanel Margin="12,0,8,0">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Renovar conexão" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Pede IP novo ao roteador. A internet cai por alguns segundos." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Appearance="Caution" Content="Redefinir" Command="{Binding FullRepairCommand}" IsEnabled="{Binding IsRepairing, Converter={StaticResource InvBool}}" />
                        <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left"><ui:SymbolIcon Symbol="Wrench24" Foreground="{DynamicResource SystemFillColorCautionBrush}" /></Border>
                        <StackPanel Margin="12,0,8,0">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Redefinir a rede" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="&quot;Conectado, sem internet&quot;. Redefine Winsock e TCP/IP; pede reinício." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
