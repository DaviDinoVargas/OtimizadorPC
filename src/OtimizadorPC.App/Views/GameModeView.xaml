<UserControl x:Class="OtimizadorPC.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
             xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
             xmlns:anim="clr-namespace:OtimizadorPC.App.Controls.Animations"
             xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
             x:Name="Root"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GameModeViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OtimizadorPC;component/Styles/Tabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:EnumEqualsConverter x:Key="EnumEq" />
            <conv:BytesConverter x:Key="Bytes" />

            <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource HoverCard}">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="18,14" />
            </Style>

            <Style x:Key="OptionRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- Botão grande do Modo Jogo -->
            <Style x:Key="PowerButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="190" Height="190">
                                <Ellipse x:Name="Pulse" Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Ring" Margin="10" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="4" Fill="{DynamicResource HeroBrush}" />
                                <Ellipse x:Name="Glow" Margin="10" Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="4" Opacity="0" Effect="{DynamicResource AccentGlowEffect}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentGlowBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding GameMode.IsActive}" Value="True">
                                    <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseLoop">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="0.85" To="1.08" Duration="0:0:1.6" />
                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="0.85" To="1.08" Duration="0:0:1.6" />
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PulseLoop" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Padding="{DynamicResource PagePadding}">
        <StackPanel>
            <c:PageHeader Title="Modo Jogo" Subtitle="Um clique antes de jogar: menos coisas rodando, energia no máximo e o jogo em primeiro lugar">
                <c:PageHeader.Animation><anim:ControllerAnimation /></c:PageHeader.Animation>
            </c:PageHeader>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Botão + estado -->
                <Border Style="{StaticResource Card}" Padding="26,20" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource AccentGlowBrush}">
                    <StackPanel Width="230">
                        <Button Style="{StaticResource PowerButton}" HorizontalAlignment="Center" Command="{Binding ToggleGameModeCommand}"
                                IsEnabled="{Binding GameMode.IsBusy, Converter={StaticResource InvBool}}" AutomationProperties.Name="Ligar ou desligar o Modo Jogo">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Games24" FontSize="46" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Filled="{Binding GameMode.IsActive}" />
                                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="LIGAR" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameMode.IsActive}" Value="True"><Setter Property="Text" Value="DESLIGAR" /></DataTrigger>
                                                <DataTrigger Binding="{Binding GameMode.IsBusy}" Value="True"><Setter Property="Text" Value="AGUARDE…" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <TextBlock HorizontalAlignment="Center" Margin="0,14,0,2" FontFamily="{StaticResource DisplayFont}" FontSize="20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Desligado" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameMode.IsActive}" Value="True">
                                            <Setter Property="Text" Value="Ligado" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding GameMode.StartedAt, StringFormat=desde {0:HH:mm}}"
                                   Visibility="{Binding GameMode.IsActive, Converter={StaticResource BoolVis}}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Também dá para ligar pelo ícone na bandeja, perto do relógio." Visibility="{Binding GameMode.IsActive, Converter={StaticResource InvBoolVis}}" />
                    </StackPanel>
                </Border>

                <!-- O que faz -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Margin="0,0,0,12" Text="AO LIGAR" />
                            <Grid Style="{StaticResource OptionRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="DismissCircle24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Fechar programas dispensáveis" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Atualizadores, relatórios de falha e ajudantes que a página Processos já marca como dispensáveis." />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding CloseDispensable}" AutomationProperties.Name="Fechar dispensáveis" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Energia no máximo" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Ativa o plano Desempenho Máximo enquanto joga e volta para o seu plano ao desligar." />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding MaxPerformancePlan}" AutomationProperties.Name="Energia no máximo" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Rocket24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Jogo com prioridade alta" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Reconhece jogos da Steam, Riot, Epic, HoYoPlay, Xbox e outros — inclusive os que você abrir depois." />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding BoostGames}" AutomationProperties.Name="Prioridade para jogos" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRow}" Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="ArrowUndo24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Reabrir o que foi fechado ao desligar" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Normalmente não precisa: esses programas voltam sozinhos quando o Windows reinicia." />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding ReopenClosed}" AutomationProperties.Name="Reabrir ao desligar" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ui:InfoBar Margin="0,0,12,12" IsOpen="True" IsClosable="False" Severity="Success" Title="Modo Jogo" Message="{Binding GameMode.Summary}"
                                Visibility="{Binding GameMode.Summary, Converter={StaticResource NullVis}}" />

                    <Border Style="{StaticResource Card}" Visibility="{Binding GameMode.IsActive, Converter={StaticResource BoolVis}}">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource CaptionText}" Text="Fechados" />
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{Binding GameMode.ClosedNames.Count, StringFormat={}{0} programa(s)}" />
                                <ItemsControl ItemsSource="{Binding GameMode.ClosedNames}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding GameMode.FreedMemory, Converter={StaticResource Bytes}, StringFormat=Memória liberada: {0}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Text="Jogos com prioridade alta" />
                                <TextBlock FontWeight="SemiBold" Text="Nenhum jogo aberto ainda">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameMode.BoostedGames.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding GameMode.BoostedGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <ui:SymbolIcon Symbol="Games24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bandeja e limpeza automática -->
            <TextBlock Style="{StaticResource Eyebrow}" Margin="2,10,0,8" Text="SEGUNDO PLANO" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><ui:SymbolIcon Symbol="ArrowMinimize24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Fechar vai para a bandeja" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="O X esconde a janela perto do relógio. Pelo ícone você liga o Modo Jogo, faz a limpeza rápida ou sai de vez." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Top" IsChecked="{Binding MinimizeToTray}" AutomationProperties.Name="Fechar vai para a bandeja" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><ui:SymbolIcon Symbol="CalendarClock24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Limpeza automática" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Roda sozinha, sem abrir a janela, só com os itens seguros. Se o PC estiver desligado no horário, roda quando ligar." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Top" IsChecked="{Binding AutoCleanupEnabled}" AutomationProperties.Name="Limpeza automática" />
                        </Grid>
                        <WrapPanel Margin="52,12,0,0" IsEnabled="{Binding AutoCleanupEnabled}">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Freq" Content="Todo dia" IsChecked="{Binding Frequency, Converter={StaticResource EnumEq}, ConverterParameter=Diaria}" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Freq" Content="Toda semana" IsChecked="{Binding Frequency, Converter={StaticResource EnumEq}, ConverterParameter=Semanal}" />
                            <ComboBox Width="130" Margin="8,0,8,6" ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" Visibility="{Binding IsWeekly, Converter={StaticResource BoolVis}}"
                                      AutomationProperties.Name="Dia da semana" />
                            <ComboBox Width="100" Margin="0,0,8,6" ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" AutomationProperties.Name="Horário" />
                        </WrapPanel>
                        <Grid Margin="52,6,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding NextRunText, StringFormat=Próxima: {0}}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding LastRunText, StringFormat=Última: {0}}" />
                                <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{Binding AutoCleanupScope, StringFormat=Inclui: {0}}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="52,10,0,0">
                            <ui:Button Content="Executar agora" Icon="{ui:SymbolIcon Broom24}" Command="{Binding RunCleanupNowCommand}" IsEnabled="{Binding IsCleaning, Converter={StaticResource InvBool}}" />
                            <ui:ProgressRing Width="18" Height="18" Margin="10,0,0,0" IsIndeterminate="True" Visibility="{Binding IsCleaning, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                        <TextBlock Margin="52,8,0,0" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding ScheduleMessage}" Visibility="{Binding ScheduleMessage, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
