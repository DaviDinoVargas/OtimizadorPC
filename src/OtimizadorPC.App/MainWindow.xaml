<ui:FluentWindow x:Class="OtimizadorPC.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
                 xmlns:nav="clr-namespace:OtimizadorPC.App.Navigation"
                 xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
                 xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
                 mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="OtimizadorPC" Width="1280" Height="820" MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type nav:NavItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="2,0,0,0" />
                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolVis}}" />
                <Border Grid.Column="2" CornerRadius="8" Padding="6,1" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding Badge, Converter={StaticResource NullVis}}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding Badge}" />
                </Border>
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OtimizadorPC" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="Auto" />
                <ColumnDefinition x:Name="ContentColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border x:Name="Sidebar" Grid.Column="0" Width="248">
                <DockPanel Margin="10,0,10,12">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Style="{StaticResource SidebarIconButton}" HorizontalAlignment="Left" Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Expandir ou recolher o menu">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="20" />
                        </Button>
                    </Grid>

                    <ListBox DockPanel.Dock="Bottom" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItemStyle}"
                             ItemTemplate="{StaticResource NavItemTemplate}" ItemsSource="{Binding FooterItems}" SelectedItem="{Binding SelectedFooterItem}" />
                    <Separator DockPanel.Dock="Bottom" Margin="4,8" Opacity="0.4" />

                    <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItemStyle}"
                             ItemTemplate="{StaticResource NavItemTemplate}" ItemsSource="{Binding MainItems}" SelectedItem="{Binding SelectedMainItem}" />
                </DockPanel>
            </Border>

            <!-- Conteúdo -->
            <Border x:Name="ContentHost" Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid x:Name="ScaleHost">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <c:AnimatedContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
