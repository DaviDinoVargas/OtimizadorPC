<ui:FluentWindow x:Class="OtimizadorPC.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:vm="clr-namespace:OtimizadorPC.App.ViewModels"
                 xmlns:nav="clr-namespace:OtimizadorPC.App.Navigation"
                 xmlns:c="clr-namespace:OtimizadorPC.App.Controls"
                 xmlns:conv="clr-namespace:OtimizadorPC.App.Converters"
                 mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="OtimizadorPC" Width="1280" Height="820" MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None" WindowCornerPreference="Round" Background="{DynamicResource ApplicationBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type nav:NavItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Icon}" FontSize="20" Margin="2,0,0,0" />
                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolVis}}" />
                <Border Grid.Column="2" CornerRadius="8" Padding="6,1" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding Badge, Converter={StaticResource NullVis}}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding Badge}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Itens agrupados por seção -->
        <CollectionViewSource x:Key="GroupedNav" Source="{Binding MainItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ícone na bandeja (perto do relógio) -->
        <tray:NotifyIcon x:Name="Tray" Grid.Row="0" FocusOnLeftClick="True" MenuOnRightClick="True" TooltipText="OtimizadorPC"
                         Icon="pack://application:,,,/Assets/logo.png" LeftClick="OnTrayOpen">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Abrir o OtimizadorPC" FontWeight="SemiBold" Click="OnTrayOpen" />
                    <Separator />
                    <MenuItem x:Name="TrayGameMode" Header="Ligar Modo Jogo" Click="OnTrayGameMode">
                        <MenuItem.Icon><ui:SymbolIcon Symbol="Games24" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Limpeza rápida" Click="OnTrayCleanup">
                        <MenuItem.Icon><ui:SymbolIcon Symbol="Broom24" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Analisar disco (Dinosize)" Click="OnTrayDinosize">
                        <MenuItem.Icon><ui:SymbolIcon Symbol="DataTreemap24" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Sair" Click="OnTrayExit">
                        <MenuItem.Icon><ui:SymbolIcon Symbol="Power24" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:TitleBar Grid.Row="0" Title="" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="Auto" />
                <ColumnDefinition x:Name="ContentColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border x:Name="Sidebar" Grid.Column="0" Width="248" Background="{DynamicResource SidebarBackgroundBrush}">
                <DockPanel Margin="10,0,10,12">
                    <!-- Marca -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SidebarIconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Expandir ou recolher o menu"
                                AutomationProperties.Name="Expandir ou recolher o menu">
                            <Image Width="26" Height="26" Source="pack://application:,,,/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsCompact, Converter={StaticResource InvBoolVis}}">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="{DynamicResource AccentGradientBrush}" Text="OTIMIZADOR PC" />
                            <TextBlock Style="{StaticResource Eyebrow}" Text="DESEMPENHO SEM ESFORÇO" />
                        </StackPanel>
                    </Grid>

                    <ListBox DockPanel.Dock="Bottom" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItemStyle}"
                             ItemTemplate="{StaticResource NavItemTemplate}" ItemsSource="{Binding FooterItems}" SelectedItem="{Binding SelectedFooterItem}" />
                    <Border DockPanel.Dock="Bottom" Height="1" Margin="8,10" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <ListBox Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItemStyle}"
                             ItemTemplate="{StaticResource NavItemTemplate}" ItemsSource="{Binding Source={StaticResource GroupedNav}}" SelectedItem="{Binding SelectedMainItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Eyebrow}" Margin="14,12,0,4" Text="{Binding Name}"
                                                   Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolVis}}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Conteúdo -->
            <Border x:Name="ContentHost" Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid x:Name="ScaleHost" ClipToBounds="True">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <!-- Luzes suaves de fundo -->
                    <Border Background="{DynamicResource BackgroundGlowBrush}" IsHitTestVisible="False" />
                    <Border Background="{DynamicResource BackgroundGlow2Brush}" IsHitTestVisible="False" />
                    <c:AnimatedContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
